# ──────────────────────────────────────────────────────────────────────────
# Growatt OSS (credenciales del portal). NO subir el .env real al repo.
# ──────────────────────────────────────────────────────────────────────────
GROWATT_USER=tu_usuario
GROWATT_PASSWORD=tu_password
GROWATT_LOGIN_URL=https://oss.growatt.com/login?lang=en

# ──────────────────────────────────────────────────────────────────────────
# Scraper
# ──────────────────────────────────────────────────────────────────────────
# true en Docker (sin pantalla), false en local para ver el navegador y depurar.
SCRAPER_HEADLESS=true
# Plantas a procesar (IDs separados por coma). Por defecto solo POLLO COA.
TARGET_PLANT_IDS=1878757
# Días hacia atrás de curva Hour (5-min) que mantiene "caliente" el sync.
HOURLY_DAYS_BACK=7
SNAPSHOT_DIR=snapshots

# ──────────────────────────────────────────────────────────────────────────
# Base de datos
# ──────────────────────────────────────────────────────────────────────────
# Dentro de docker-compose el host es "db"; en local usa "localhost".
DATABASE_URL=postgresql+psycopg://growatt:growatt@db:5432/growatt
POSTGRES_USER=growatt
POSTGRES_PASSWORD=growatt
POSTGRES_DB=growatt

# ──────────────────────────────────────────────────────────────────────────
# API
# ──────────────────────────────────────────────────────────────────────────
# main -> EDEMCO_2026_GROWAT_GENERACION ; staging/dev -> PRUEBAS_GROWAT_GENERACION
API_KEY=EDEMCO_2026_GROWAT_GENERACION
TZ=America/Bogota

# Puertos del host. Cámbialos si 5432/8000 ya están ocupados en tu máquina.
DB_PORT=5432
API_PORT=8000
